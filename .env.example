# Copiar para .env na Magi (NÃO commitar .env). chmod 600 .env

# --- Rede (Tailscale-only) ---
# IP Tailscale da Magi (tailscale ip -4). Nunca 0.0.0.0 no host publish.
MAGI_BIND_IP=100.77.52.14
# Bind da API DENTRO do container (host publish usa MAGI_BIND_IP abaixo)
BIND_ADDR=0.0.0.0:8787
API_PORT=8787
WEB_PORT=8080

# URLs no tailnet (MagicDNS: magi / magi.tailcfeeb7.ts.net)
PUBLIC_API_BASE_URL=http://magi.tailcfeeb7.ts.net:8787
PUBLIC_WS_URL=ws://magi.tailcfeeb7.ts.net:8787/v1/stream
L2S_BUS_INGEST_URL=http://magi.tailcfeeb7.ts.net:8787/v1/events

# --- Segurança / API (canônico Backend) ---
# openssl rand -hex 32
L2S_BUS_HMAC_SECRET=CHANGE_ME_openssl_rand_hex_32
L2S_BUS_ALLOWLIST=
DATABASE_PATH=/data/events.sqlite
# Opcional
# MAGI_PANEL_TOKEN=
# RATE_LIMIT_PER_MIN=120

# Host publish Compose (host → container): só MAGI_BIND_IP
