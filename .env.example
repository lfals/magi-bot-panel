# Copiar para .env na Magi (NÃO commitar .env). chmod 600 .env

# --- Rede (Tailscale-only) ---
# IP Tailscale da Magi (tailscale ip -4). Nunca 0.0.0.0.
MAGI_BIND_IP=100.x.y.z
# Bind da API dentro do container / processo (Backend)
BIND_ADDR=0.0.0.0:8787
API_PORT=8787
WEB_PORT=8080

# URLs no tailnet (MagicDNS Magi — confirmar hostname real no deploy)
PUBLIC_API_BASE_URL=http://magi:8787
PUBLIC_WS_URL=ws://magi:8787/v1/stream
L2S_BUS_INGEST_URL=http://magi:8787/v1/events

# --- Segurança / API (canônico Backend) ---
# openssl rand -hex 32
L2S_BUS_HMAC_SECRET=CHANGE_ME_openssl_rand_hex_32
L2S_BUS_ALLOWLIST=
DATABASE_PATH=/data/events.sqlite
# Opcional: token extra na UI/REST se exigido depois
# MAGI_PANEL_TOKEN=

# Host publish Compose (host → container): só MAGI_BIND_IP
